# Mẫu biến môi trường. Chép thành .env.local rồi điền; không bao giờ commit .env.local.

# Thư viện 3D (model, bầu trời) trên CDN, ví dụ https://assets.example.com (không có dấu / cuối).
# Để trống: khi dev, model đọc từ thư viện trong máy qua /dev-assets (app/dev-assets/[...path]/route.ts);
# trên bản chính thức, để trống nghĩa là model trả 404 và cảnh dùng mô hình dựng bằng code.
# CDN phải có các thư mục web/, low/, mid/, hdri/ (đẩy bằng scripts/sync-assets-r2.mjs) và CORS cho tên miền của app.
NEXT_PUBLIC_ASSET_BASE_URL=

# Cloudflare R2 cho scripts/sync-assets-r2.mjs (khóa API loại "Object Read & Write" cho bucket này).
# Link công khai r2.dev bị giới hạn tốc độ: chỉ dùng để thử; bản chính thức gắn tên miền riêng cho bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tutorcraft-assets
R2_PUBLIC_URL=
